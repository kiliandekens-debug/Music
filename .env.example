# Copier ce fichier vers .env.local puis remplir les valeurs,
# ou lancer « npm run setup » qui s'en charge.
#
# Tableau de bord Supabase -> Project Settings -> API
# https://supabase.com/dashboard/project/blglfpyecmlepybusdrz/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://blglfpyecmlepybusdrz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# URL publique de l'application (utilisée pour les liens de connexion par e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ATTENTION : ne jamais placer la clé "service_role" dans une variable NEXT_PUBLIC_*.
# Elle contourne la Row Level Security et ne doit jamais atteindre le navigateur.
