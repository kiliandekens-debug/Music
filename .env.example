# Copier ce fichier vers .env.local puis remplir les valeurs,
# ou lancer « npm run setup » qui s'en charge.
#
# Tableau de bord Supabase -> Project Settings -> API Keys
# https://supabase.com/dashboard/project/blglfpyecmlepybusdrz/settings/api-keys
#
# La clé attendue est la clé PUBLIQUE : « publishable » (sb_publishable_...)
# dans le format récent, « anon » (eyJ...) dans l'ancien. Elle est faite pour
# vivre dans le navigateur.

NEXT_PUBLIC_SUPABASE_URL=https://blglfpyecmlepybusdrz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_publishable

# L'URL de retour des liens de connexion est déduite du navigateur : la même
# configuration fonctionne en local, en production et sur les déploiements de
# prévisualisation. Aucune variable supplémentaire n'est nécessaire.

# ATTENTION : ne jamais placer ici la clé SECRÈTE (sb_secret_... ou service_role).
# Elle contourne la Row Level Security et ne doit jamais atteindre le navigateur.
# L'application n'en a aucun besoin. Si elle a été exposée, révoquez-la.
